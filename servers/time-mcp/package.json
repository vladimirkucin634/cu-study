{
  "name": "cu-time-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Local MCP server for the CU TiME messenger",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "cu-time-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "time-messenger",
    "mattermost",
    "chat",
    "messenger",
    "t-bank",
    "corporate-messenger"
  ],
  "author": "Vladimir Kuchin",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "dotenv": "18.0.8",
    "playwright-core": "1.64.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@hono/node-server": "1.19.17",
    "body-parser": "2.3.0",
    "fast-uri": "3.1.8",
    "hono": "4.13.13",
    "ip-address": "10.7.4",
    "proxy-addr": "2.0.8",
    "qs": "6.16.1"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
